# Copy to /etc/todo-bot/env (root:root, mode 0600).
# Lines are KEY=value with no quotes and no "export".

# Required: bot token from @BotFather.
TELEGRAM_TOKEN=123456:replace-me
# Required: comma-separated numeric Telegram user IDs.
TODO_ALLOWED_USERS=11111,22222

# Default time zone (IANA name). Default: UTC.
TODO_DEFAULT_TZ=Europe/Berlin
# Time used for a date with no time, and for snooze "tomorrow" (HH:MM).
TODO_DEFAULT_TIME=09:00
# debug|info|warn|error
TODO_LOG_LEVEL=info

# Database location. With StateDirectory=todo-bot the default is
# $STATE_DIRECTORY/todo.db, so this can stay as it is.
TODO_DB_PATH=/var/lib/todo-bot/todo.db
# Database URL (multi-node design, see docs/ARCHITECTURE.md section 9).
# Single-host v0.1 uses SQLite. The two-node deploy is tracked in #34.
TODO_DB_URL=sqlite:///var/lib/todo-bot/todo.db
# Unique name of this node. Keep "node1" on a single host.
TODO_NODE_ID=node1
