[Unit]
Description=Todo Telegram bot
Documentation=https://github.com/sadeq-n-yazdi/todo-bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=todo-bot
Group=todo-bot
ExecStart=/opt/todo-bot/todo-bot run
EnvironmentFile=/etc/todo-bot/env
Environment=GOMEMLIMIT=40MiB
StateDirectory=todo-bot
StateDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=5s
# Shutdown: lease release (≤5s) + scheduler write (≤5s) within a 10s app budget.
TimeoutStopSec=20s

# Resources (vps00 has about 860MB of RAM)
MemoryMax=96M
TasksMax=64

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Mandatory: without it a blocked syscall kills the process with SIGSYS.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
